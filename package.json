{
  "name": "papex-app",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Official mobile client for the Papex academic literature platform (Android / HarmonyOS / iOS).",
  "author": "The Papex Authors",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "gen:types": "bash scripts/gen-types.sh",
    "sync:i18n": "bash scripts/sync-i18n.sh",
    "e2e:ios": "detox build --configuration ios.sim && detox test --configuration ios.sim",
    "e2e:android": "detox build --configuration android.emu && detox test --configuration android.emu",
    "release:android": "bash scripts/release-android.sh",
    "release:ios": "bash scripts/release-ios.sh",
    "release:harmony": "bash scripts/release-harmony.sh"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.1.0",
    "i18next": "^23.16.0",
    "react": "19.1.1",
    "react-i18next": "^15.1.0",
    "react-native": "0.82.0",
    "react-native-keychain": "^8.2.0",
    "react-native-mmkv": "^3.2.0",
    "react-native-pdf": "^6.7.0",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-typescript": "^7.24.0",
    "@react-native/babel-preset": "^0.82.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.7.2",
    "@types/jest": "^29.5.12",
    "@types/react": "19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "detox": "^20.27.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.3.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@types/react": "19.1.0"
  },
  "detox": {
    "configurations": {
      "ios.sim": {
        "type": "ios.app",
        "device": {
          "type": "iPhone 16"
        },
        "app": {
          "type": "ios.app",
          "binaryPath": "ios/build/Build/Products/Release-iphonesimulator/papex.app",
          "build": "xcodebuild -workspace ios/papex.xcworkspace -scheme papex -configuration Release -sdk iphonesimulator -derivedDataPath ios/build"
        }
      },
      "android.emu": {
        "type": "android.apk",
        "device": {
          "avdName": "Pixel_7_API_34"
        },
        "app": {
          "type": "android.apk",
          "binaryPath": "android/app/build/outputs/apk/release/app-release.apk",
          "build": "cd android && ./gradlew assembleRelease assembleAndroidTest -DtestBuildType=release"
        }
      }
    }
  }
}
