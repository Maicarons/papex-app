# Papex server base URL (no trailing slash). Used by lib/api/endpoints.ts.
API_BASE_URL=https://api.papex.example.com

# Enable push registration (FCM / APNs / PushKit).
PUSH_ENABLED=true

# Fallback language when device locale is not zh/en. One of: zh | en
I18N_FALLBACK=zh

# When true, the API client logs request/response metadata (never tokens).
API_DEBUG=false

# Demo mode: when the backend refresh/devices endpoints are not yet deployed,
# the client authenticates with an API Key bearer token and stubs the
# device-management / reading-progress flows. Remove once backend lands.
API_DEMO_MODE=false
PAPEX_API_KEY=
